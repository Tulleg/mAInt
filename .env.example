# ==============================================================================
# MaintAI - Environment Configuration Template
# ==============================================================================

# Core Application
NODE_ENV=production
PORT=3000

# Database (PostgreSQL with pgvector)
# For Coolify Docker Compose: postgresql://postgres:postgrespassword@postgres:5432/maintai
# For Coolify Managed DB: use the internal connection string provided by Coolify
DATABASE_URL=postgresql://postgres:postgrespassword@postgres:5432/maintai

# In-Memory Cache (Redis)
# For Coolify Docker Compose: redis://redis:6379
# For Coolify Managed Redis: use the internal connection string provided by Coolify
REDIS_URL=redis://redis:6379

# Database Credentials (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=maintai

# Security & Encryption (Generate with: openssl rand -base64 32)
AI_ENCRYPTION_KEY=replace-with-a-secure-random-32-byte-base64-string
NEXTAUTH_SECRET=replace-with-a-secure-random-secret

# AI Copilot & LLM Configuration (Optional, defaults to GEMINI if GEMINI_API_KEY is present)
AI_PROVIDER=GEMINI
GEMINI_API_KEY=
# Alternative LLM Provider:
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# SAP Integration Mode (STANDALONE | ODATA_V4 | RFC_BAPI | REST_MIDDLEWARE)
SAP_MODE=STANDALONE
